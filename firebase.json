{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/images/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.webp",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "**/*.@(woff|woff2|ttf|otf)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "index.html",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      }
    ],
    "redirects": [
      { "source": "/suporte", "destination": "/soporte", "type": 301 },
      { "source": "/suporte/", "destination": "/soporte", "type": 301 },
      { "source": "/privacidade", "destination": "/privacidad", "type": 301 },
      { "source": "/privacidade/", "destination": "/privacidad", "type": 301 }
    ],
    "rewrites": [
      { "source": "/soporte", "destination": "/soporte.html" },
      { "source": "/soporte/", "destination": "/soporte.html" },
      { "source": "/privacidad", "destination": "/privacidad.html" },
      { "source": "/privacidad/", "destination": "/privacidad.html" },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
